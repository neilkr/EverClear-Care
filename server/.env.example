# Server environment variables (copy to .env and fill in real values)
PORT=4000
JWT_SECRET=replace_with_a_long_random_secret_value
JWT_EXPIRES_IN=12h
DB_PATH=./data/care.db
# Minutes after a scheduled task's time before it is considered "missed" and the caregiver is alerted
GRACE_PERIOD_MINUTES=30
CLIENT_ORIGIN=http://localhost:5173
